{
  "name": "@ledgerline/core",
  "version": "0.1.0",
  "description": "TypeScript SDK for CortexRails Protocol -- a typed viem client over the deployed Registry/Policy/LendingAdapter/VaultAdapter/TransferAdapter contracts on Robinhood Chain testnet.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./agentkit": {
      "types": "./dist/integrations/agentkit.d.ts",
      "require": "./dist/integrations/agentkit.js",
      "default": "./dist/integrations/agentkit.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "node --import tsx --test test/**/*.test.ts",
    "oracle-sync": "tsx scripts/oracle-sync.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "@coinbase/agentkit": "^0.10.4",
    "viem": "^2.0.0",
    "zod": "^3.25.76"
  },
  "peerDependenciesMeta": {
    "@coinbase/agentkit": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@coinbase/agentkit": "^0.10.4",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "viem": "^2.56.5",
    "zod": "^3.25.76"
  }
}
