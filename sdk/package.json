{
  "name": "@ledgerline/core",
  "version": "0.1.0",
  "description": "TypeScript SDK for CortexRails Protocol -- a typed viem client over the deployed Registry/Policy/LendingAdapter/VaultAdapter/TransferAdapter contracts on Robinhood Chain testnet.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "viem": "^2.56.5"
  }
}
